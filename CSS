/* styles.css */
/* Animaciones y estilos personalizados adicionales */

.card-compu {
  transition: all 0.2s ease-in-out;
}

.card-compu:hover {
  transform: translateY(-2px);
}

/* Scrollbar estilizado para la tabla */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: #0f172a;
}

::-webkit-scrollbar-thumb {
  background: #334155;
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: #475569;
}
