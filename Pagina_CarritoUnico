<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Espacio Digital - Control de Carrito Único</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- QRCode.js CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <!-- Google Font Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="h-full text-slate-800 flex flex-col antialiased bg-slate-100">

    <!-- Encabezado Principal -->
    <header class="bg-slate-900 text-white border-b border-slate-800 sticky top-0 z-30 shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 bg-indigo-600 rounded-xl flex items-center justify-center text-white shadow-md">
                    <i class="fa-solid fa-laptop-code text-lg"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight">Espacio Digital</h1>
                    <p class="text-xs text-indigo-300">Gestión de Carrito Único de Computadoras</p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <button onclick="resetAllLaptops()" class="text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white px-3 py-2 rounded-xl transition border border-slate-700 flex items-center gap-1.5" title="Reiniciar datos de prueba">
                    <i class="fa-solid fa-rotate-left"></i>
                    <span class="hidden sm:inline">Restablecer Carrito</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Contenido Principal -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

        <!-- Metrics Dashboard -->
        <section class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6">
            <!-- Metric 1: Total -->
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Capacidad Carrito</p>
                    <p id="stat-total" class="text-3xl font-extrabold text-slate-800 mt-1">30</p>
                </div>
                <div class="w-12 h-12 bg-slate-100 text-slate-600 rounded-2xl flex items-center justify-center">
                    <i class="fa-solid fa-box-archive text-xl"></i>
                </div>
            </div>

            <!-- Metric 2: Disponibles -->
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-emerald-600 uppercase tracking-wider">Disponibles en Carrito</p>
                    <p id="stat-available" class="text-3xl font-extrabold text-emerald-600 mt-1">0</p>
                </div>
                <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center">
                    <i class="fa-solid fa-circle-check text-xl"></i>
                </div>
            </div>

            <!-- Metric 3: Prestadas -->
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-rose-500 uppercase tracking-wider">Computadoras Afuera</p>
                    <p id="stat-loaned" class="text-3xl font-extrabold text-rose-600 mt-1">0</p>
                </div>
                <div class="w-12 h-12 bg-rose-50 text-rose-600 rounded-2xl flex items-center justify-center">
                    <i class="fa-solid fa-clock text-xl"></i>
                </div>
            </div>
        </section>

        <!-- Filtros y Búsqueda -->
        <section class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="relative w-full md:w-80">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                <input type="text" id="search-input" oninput="renderGrid()" placeholder="Buscar compu, alumno o profesor..." class="w-full pl-9 pr-4 py-2 text-sm border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>

            <div class="flex items-center gap-2 w-full md:w-auto overflow-x-auto pb-1 md:pb-0">
                <button onclick="setFilter('all')" id="filter-all" class="px-3.5 py-1.5 text-xs font-semibold rounded-xl bg-slate-900 text-white shadow-sm transition">
                    Todas (30)
                </button>
                <button onclick="setFilter('available')" id="filter-available" class="px-3.5 py-1.5 text-xs font-semibold rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200 transition">
                    Ver Disponibles
                </button>
                <button onclick="setFilter('loaned')" id="filter-loaned" class="px-3.5 py-1.5 text-xs font-semibold rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200 transition">
                    Ver Prestadas
                </button>
            </div>
        </section>

        <!-- Matriz del Carrito (Grid 30 Compus) -->
        <section>
            <div class="flex items-center justify-between mb-4">
                <h2 class="font-bold text-slate-800 text-base flex items-center gap-2">
                    <i class="fa-solid fa-border-all text-indigo-600"></i>
                    Matriz de Computadoras del Carrito
                </h2>
                <span class="text-xs text-slate-500">Haz clic en "Prestar" o "Devolver" para actualizar el estado</span>
            </div>

            <div id="laptops-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
                <!-- Se inyecta dinámicamente con JS -->
            </div>
        </section>

        <!-- Historial de Devoluciones -->
        <section class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mt-8">
            <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                <h3 class="font-bold text-slate-800 text-sm flex items-center gap-2">
                    <i class="fa-solid fa-clock-rotate-left text-indigo-600"></i>
                    Historial de Préstamos Devueltos
                </h3>
                <span id="history-count-badge" class="text-xs font-semibold px-2.5 py-1 bg-slate-100 text-slate-600 rounded-full">0 registros</span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="bg-slate-50 text-slate-400 font-semibold text-xs uppercase tracking-wider border-b border-slate-200">
                        <tr>
                            <th class="px-6 py-3">Compu N°</th>
                            <th class="px-6 py-3">Alumno (Se la llevó)</th>
                            <th class="px-6 py-3">Profesor / Preceptor</th>
                            <th class="px-6 py-3">Hora Salida</th>
                            <th class="px-6 py-3">Hora Devolución</th>
                            <th class="px-6 py-3">Tiempo Afuera</th>
                        </tr>
                    </thead>
                    <tbody id="history-table-body" class="divide-y divide-slate-100 text-slate-700">
                        <!-- Se inyecta con JS -->
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <!-- Modal: Prestar Compu -->
    <div id="loan-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl shadow-xl max-w-md w-full overflow-hidden border border-slate-100">
            <div class="px-6 py-4 bg-slate-900 text-white flex justify-between items-center">
                <h3 class="font-bold text-sm flex items-center gap-2">
                    <i class="fa-solid fa-arrow-up-from-bracket text-emerald-400"></i>
                    Registrar Salida de <span id="modal-laptop-title" class="text-indigo-300">Compu --</span>
                </h3>
                <button onclick="closeLoanModal()" class="text-slate-400 hover:text-white transition">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <form id="loan-form" onsubmit="confirmLoan(event)" class="p-6 space-y-4">
                <input type="hidden" id="modal-laptop-id">

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Alumno / Alumna que se la lleva *</label>
                    <input type="text" id="input-student" required placeholder="Ej: Santiago Pérez (4° Año B)" class="w-full border border-slate-300 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Profesor / Preceptor que la presta *</label>
                    <input type="text" id="input-teacher" required placeholder="Ej: Prof. Gómez" class="w-full border border-slate-300 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Observaciones / Estado previo</label>
                    <input type="text" id="input-notes" placeholder="Ej: Incluye cargador, detalle en carcasa..." class="w-full border border-slate-300 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                </div>

                <div class="pt-2 flex gap-3">
                    <button type="button" onclick="closeLoanModal()" class="w-1/2 py-2.5 border border-slate-300 text-slate-700 font-medium text-sm rounded-xl hover:bg-slate-50 transition">
                        Cancelar
                    </button>
                    <button type="submit" class="w-1/2 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-medium text-sm rounded-xl shadow-sm transition">
                        Confirmar Salida
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal: Código QR y Ficha -->
    <div id="qr-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl shadow-xl max-w-sm w-full overflow-hidden border border-slate-100 text-center">
            <div class="p-4 bg-slate-900 text-white flex justify-between items-center">
                <span class="text-xs font-bold uppercase tracking-widest text-indigo-300">Ficha QR - Espacio Digital</span>
                <button onclick="closeQrModal()" class="text-slate-400 hover:text-white transition">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <div class="p-6 space-y-4">
                <div class="flex justify-center">
                    <div id="qrcode-box" class="p-3 bg-white border-2 border-dashed border-indigo-200 rounded-2xl inline-block shadow-inner min-w-[170px] min-h-[170px]"></div>
                </div>

                <div id="qr-modal-badge" class="inline-block px-3 py-1 rounded-full text-xs font-bold">
                    --
                </div>

                <div class="text-left text-xs space-y-2 bg-slate-50 p-4 rounded-xl border border-slate-200">
                    <div class="flex justify-between border-b border-slate-200 pb-1">
                        <span class="text-slate-500">Equipo:</span>
                        <span id="qr-modal-laptop" class="font-bold text-slate-800">--</span>
                    </div>
                    <div class="flex justify-between border-b border-slate-200 pb-1">
                        <span class="text-slate-500">Alumno:</span>
                        <span id="qr-modal-student" class="font-semibold text-slate-800">--</span>
                    </div>
                    <div class="flex justify-between border-b border-slate-200 pb-1">
                        <span class="text-slate-500">Profesor/a:</span>
                        <span id="qr-modal-teacher" class="text-slate-700">--</span>
                    </div>
                    <div class="flex justify-between border-b border-slate-200 pb-1">
                        <span class="text-slate-500">Hora de Salida:</span>
                        <span id="qr-modal-time" class="text-slate-700">--</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-500">Tiempo Transcurrido:</span>
                        <span id="qr-modal-duration" class="font-bold text-indigo-600">--</span>
                    </div>
                </div>

                <button onclick="closeQrModal()" class="w-full py-2.5 bg-slate-900 text-white text-sm font-medium rounded-xl hover:bg-slate-800 transition">
                    Cerrar Ficha
                </button>
            </div>
        </div>
    </div>

    <!-- Script Lógica de Gestión de Carrito -->
    <script>
        const STORAGE_KEY = 'espacio_digital_single_cart_v1';
        const TOTAL_LAPTOPS = 30;

        let laptops = [];
        let historyLoans = [];
        let currentFilter = 'all';

        // Al iniciar la aplicación
        window.addEventListener('DOMContentLoaded', () => {
            initData();
            renderGrid();
            renderHistory();
            updateDashboard();

            // Intervalo en vivo para actualizar cronómetros cada segundo
            setInterval(updateLiveTimers, 1000);
        });

        // Genera o carga los 30 slots de computadoras
        function initData() {
            const savedData = localStorage.getItem(STORAGE_KEY);
            if (savedData) {
                try {
                    const parsed = JSON.parse(savedData);
                    laptops = parsed.laptops || [];
                    historyLoans = parsed.historyLoans || [];
                } catch (e) {
                    generateDefaultLaptops();
                }
            } else {
                generateDefaultLaptops();
            }
        }

        function generateDefaultLaptops() {
            laptops = [];
            historyLoans = [];

            // Creamos las 30 computadoras
            for (let i = 1; i <= TOTAL_LAPTOPS; i++) {
                const numStr = String(i).padStart(2, '0');
                laptops.push({
                    id: `COMPU-${numStr}`,
                    number: i,
                    status: 'available', // 'available' o 'loaned'
                    student: '',
                    teacher: '',
                    notes: '',
                    startTime: null
                });
            }

            // Datos iniciales de prueba para ver dinamismo
            laptops[2].status = 'loaned'; // Compu 03
            laptops[2].student = 'Lucas M. (5° Año)';
            laptops[2].teacher = 'Prof. Rossi';
            laptops[2].startTime = new Date(Date.now() - (35 * 60 * 1000 + 40 * 1000)).toISOString();

            laptops[7].status = 'loaned'; // Compu 08
            laptops[7].student = 'Valentina K. (3° Año)';
            laptops[7].teacher = 'Prof. Gómez';
            laptops[7].startTime = new Date(Date.now() - (115 * 60 * 1000 + 10 * 1000)).toISOString();

            saveData();
        }

        function saveData() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify({
                laptops,
                historyLoans
            }));
            updateDashboard();
        }

        function resetAllLaptops() {
            if (confirm('¿Deseas restablecer las 30 computadoras al estado inicial de fábrica?')) {
                generateDefaultLaptops();
                renderGrid();
                renderHistory();
            }
        }

        function setFilter(filter) {
            currentFilter = filter;
            ['all', 'available', 'loaned'].forEach(f => {
                const btn = document.getElementById(`filter-${f}`);
                if (f === filter) {
                    btn.className = "px-3.5 py-1.5 text-xs font-semibold rounded-xl bg-slate-900 text-white shadow-sm transition";
                } else {
                    btn.className = "px-3.5 py-1.5 text-xs font-semibold rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200 transition";
                }
            });
            renderGrid();
        }

        function updateDashboard() {
            const available = laptops.filter(l => l.status === 'available').length;
            const loaned = laptops.filter(l => l.status === 'loaned').length;

            document.getElementById('stat-total').innerText = TOTAL_LAPTOPS;
            document.getElementById('stat-available').innerText = available;
            document.getElementById('stat-loaned').innerText = loaned;

            document.getElementById('history-count-badge').innerText = `${historyLoans.length} registro(s)`;
        }

        function formatExactDuration(startIso, endIso = null) {
            if (!startIso) return '00:00:00';
            const start = new Date(startIso);
            const end = endIso ? new Date(endIso) : new Date();
            const diffMs = Math.max(0, end - start);

            const totalSeconds = Math.floor(diffMs / 1000);
            const hours = Math.floor(totalSeconds / 3600);
            const minutes = Math.floor((totalSeconds % 3600) / 60);
            const seconds = totalSeconds % 60;

            const pad = (n) => String(n).padStart(2, '0');
            return `${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;
        }

        function formatTimeShort(isoString) {
            if (!isoString) return '--';
            const date = new Date(isoString);
            return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }

        function updateLiveTimers() {
            const timers = document.querySelectorAll('.live-timer');
            timers.forEach(el => {
                const startTime = el.getAttribute('data-start');
                if (startTime) {
                    el.innerText = formatExactDuration(startTime);
                }
            });
        }

        function renderGrid() {
            const grid = document.getElementById('laptops-grid');
            grid.innerHTML = '';

            const searchVal = document.getElementById('search-input').value.toLowerCase().trim();

            const filtered = laptops.filter(laptop => {
                const matchesFilter = (currentFilter === 'all') ||
                                      (currentFilter === 'available' && laptop.status === 'available') ||
                                      (currentFilter === 'loaned' && laptop.status === 'loaned');

                const matchesSearch = laptop.id.toLowerCase().includes(searchVal) ||
                                      laptop.student.toLowerCase().includes(searchVal) ||
                                      laptop.teacher.toLowerCase().includes(searchVal);

                return matchesFilter && matchesSearch;
            });

            if (filtered.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full py-12 text-center text-slate-400 bg-white rounded-2xl border border-dashed border-slate-300">
                        <i class="fa-solid fa-laptop text-3xl mb-2 text-slate-300"></i>
                        <p class="text-sm">No se encontraron computadoras con ese filtro de búsqueda.</p>
                    </div>
                `;
                return;
            }

            filtered.forEach(laptop => {
                const isLoaned = laptop.status === 'loaned';
                const card = document.createElement('div');

                if (isLoaned) {
                    // Tarjeta Estado PRESTADA (Rojo/Naranja)
                    card.className = "bg-white rounded-2xl border-2 border-rose-300 shadow-sm p-4 flex flex-col justify-between space-y-3 relative overflow-hidden transition hover:shadow-md";
                    card.innerHTML = `
                        <div class="absolute top-0 left-0 w-full h-1.5 bg-rose-500"></div>

                        <div class="flex items-center justify-between">
                            <span class="font-black text-slate-800 text-lg flex items-center gap-1.5">
                                <i class="fa-solid fa-laptop text-rose-500"></i>
                                ${laptop.id}
                            </span>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 border border-rose-200">
                                PRESTADA
                            </span>
                        </div>

                        <div class="space-y-1.5 text-xs bg-slate-50 p-2.5 rounded-xl border border-slate-100">
                            <div>
                                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Alumno/a:</p>
                                <p class="font-bold text-slate-800 truncate">${laptop.student}</p>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Autorizó:</p>
                                <p class="font-medium text-slate-700 truncate">${laptop.teacher}</p>
                            </div>
                        </div>

                        <div class="flex items-center justify-between text-xs pt-1">
                            <span class="text-slate-400 text-[11px]">
                                Salida: <strong class="text-slate-600">${formatTimeShort(laptop.startTime)}</strong>
                            </span>
                            <span class="font-mono font-bold text-rose-600 bg-rose-50 px-2 py-0.5 rounded-md border border-rose-100">
                                <i class="fa-regular fa-clock text-[10px] mr-0.5"></i>
                                <span class="live-timer" data-start="${laptop.startTime}">${formatExactDuration(laptop.startTime)}</span>
                            </span>
                        </div>

                        <div class="pt-2 border-t border-slate-100 flex gap-2">
                            <button onclick="returnLaptop('${laptop.id}')" class="flex-1 py-2 bg-rose-600 hover:bg-rose-500 text-white font-medium text-xs rounded-xl shadow-sm transition flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-rotate-left"></i>
                                Devolver
                            </button>
                            <button onclick="openQrModal('${laptop.id}')" class="p-2 text-slate-500 hover:text-indigo-600 hover:bg-indigo-50 border border-slate-200 rounded-xl transition" title="Ver Código QR">
                                <i class="fa-solid fa-qrcode"></i>
                            </button>
                        </div>
                    `;
                } else {
                    // Tarjeta Estado DISPONIBLE (Verde)
                    card.className = "bg-white rounded-2xl border border-slate-200 shadow-sm p-4 flex flex-col justify-between space-y-3 transition hover:border-emerald-300 hover:shadow-md";
                    card.innerHTML = `
                        <div class="flex items-center justify-between">
                            <span class="font-black text-slate-800 text-lg flex items-center gap-1.5">
                                <i class="fa-solid fa-laptop text-emerald-500"></i>
                                ${laptop.id}
                            </span>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                                DISPONIBLE
                            </span>
                        </div>

                        <div class="py-3 text-center bg-emerald-50/50 rounded-xl border border-emerald-100">
                            <i class="fa-solid fa-circle-check text-emerald-500 text-xl mb-1"></i>
                            <p class="text-xs text-emerald-700 font-medium">Lista en el carrito</p>
                        </div>

                        <div class="pt-2 border-t border-slate-100 flex gap-2">
                            <button onclick="openLoanModal('${laptop.id}')" class="flex-1 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-medium text-xs rounded-xl shadow-sm transition flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-hand-holding"></i>
                                Prestar
                            </button>
                            <button onclick="openQrModal('${laptop.id}')" class="p-2 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 border border-slate-200 rounded-xl transition" title="Ver Código QR">
                                <i class="fa-solid fa-qrcode"></i>
                            </button>
                        </div>
                    `;
                }

                grid.appendChild(card);
            });
        }

        function renderHistory() {
            const tbody = document.getElementById('history-table-body');
            tbody.innerHTML = '';

            if (historyLoans.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="text-center py-6 text-slate-400 text-xs">
                            No hay devoluciones registradas en esta sesión.
                        </td>
                    </tr>
                `;
                return;
            }

            historyLoans.slice().reverse().forEach(record => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 transition";
                tr.innerHTML = `
                    <td class="px-6 py-3 font-bold text-slate-800">${record.laptopId}</td>
                    <td class="px-6 py-3 font-medium text-slate-800">${record.student}</td>
                    <td class="px-6 py-3 text-slate-600">${record.teacher}</td>
                    <td class="px-6 py-3 text-xs text-slate-500">${formatTimeShort(record.startTime)}</td>
                    <td class="px-6 py-3 text-xs text-slate-500">${formatTimeShort(record.endTime)}</td>
                    <td class="px-6 py-3">
                        <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-slate-100 text-slate-700 border border-slate-200">
                            ${record.duration}
                        </span>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function openLoanModal(laptopId) {
            document.getElementById('modal-laptop-id').value = laptopId;
            document.getElementById('modal-laptop-title').innerText = laptopId;
            document.getElementById('loan-form').reset();
            document.getElementById('loan-modal').classList.remove('hidden');
        }

        function closeLoanModal() {
            document.getElementById('loan-modal').classList.add('hidden');
        }

        function confirmLoan(e) {
            e.preventDefault();

            const laptopId = document.getElementById('modal-laptop-id').value;
            const student = document.getElementById('input-student').value.trim();
            const teacher = document.getElementById('input-teacher').value.trim();
            const notes = document.getElementById('input-notes').value.trim();

            const idx = laptops.findIndex(l => l.id === laptopId);
            if (idx !== -1) {
                laptops[idx].status = 'loaned';
                laptops[idx].student = student;
                laptops[idx].teacher = teacher;
                laptops[idx].notes = notes;
                laptops[idx].startTime = new Date().toISOString();

                saveData();
                renderGrid();
                closeLoanModal();
            }
        }

        // Devolución rápida en un solo clic
        function returnLaptop(laptopId) {
            const idx = laptops.findIndex(l => l.id === laptopId);
            if (idx !== -1 && laptops[idx].status === 'loaned') {
                const endTime = new Date().toISOString();
                const duration = formatExactDuration(laptops[idx].startTime, endTime);

                // Agregar registro al historial
                historyLoans.push({
                    id: 'hist_' + Date.now(),
                    laptopId: laptops[idx].id,
                    student: laptops[idx].student,
                    teacher: laptops[idx].teacher,
                    startTime: laptops[idx].startTime,
                    endTime: endTime,
                    duration: duration
                });

                // Resetear estado de la computadora en la matriz
                laptops[idx].status = 'available';
                laptops[idx].student = '';
                laptops[idx].teacher = '';
                laptops[idx].notes = '';
                laptops[idx].startTime = null;

                saveData();
                renderGrid();
                renderHistory();
            }
        }

        function openQrModal(laptopId) {
            const laptop = laptops.find(l => l.id === laptopId);
            if (!laptop) return;

            const isLoaned = laptop.status === 'loaned';
            const duration = isLoaned ? formatExactDuration(laptop.startTime) : '00:00:00';

            document.getElementById('qr-modal-laptop').innerText = laptop.id;
            document.getElementById('qr-modal-student').innerText = isLoaned ? laptop.student : 'En Carrito';
            document.getElementById('qr-modal-teacher').innerText = isLoaned ? laptop.teacher : 'En Carrito';
            document.getElementById('qr-modal-time').innerText = isLoaned ? formatTimeShort(laptop.startTime) : '--';
            document.getElementById('qr-modal-duration').innerText = isLoaned ? duration : '0 min';

            const badge = document.getElementById('qr-modal-badge');
            if (isLoaned) {
                badge.className = "inline-block px-3 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-800 border border-rose-200";
                badge.innerText = "ESTADO: EN USO / PRESTADA";
            } else {
                badge.className = "inline-block px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-200";
                badge.innerText = "ESTADO: DISPONIBLE EN CARRITO";
            }

            // Datos codificados en el QR
            const payload = `ESPACIO DIGITAL - CARRITO UNICO
---------------------------------
Equipo: ${laptop.id}
Estado: ${isLoaned ? 'PRESTADA' : 'GUARDADA EN CARRITO'}
Alumno: ${isLoaned ? laptop.student : 'N/A'}
Profesor: ${isLoaned ? laptop.teacher : 'N/A'}
Hora Salida: ${isLoaned ? formatTimeShort(laptop.startTime) : 'N/A'}`;

            const qrBox = document.getElementById('qrcode-box');
            qrBox.innerHTML = '';

            try {
                new QRCode(qrBox, {
                    text: payload,
                    width: 150,
                    height: 150,
                    colorDark: "#0f172a",
                    colorLight: "#ffffff",
                    correctLevel: QRCode.CorrectLevel.M
                });
            } catch (err) {
                qrBox.innerHTML = '<p class="text-xs text-red-500">Error al renderizar QR</p>';
            }

            document.getElementById('qr-modal').classList.remove('hidden');
        }

        function closeQrModal() {
            document.getElementById('qr-modal').classList.add('hidden');
        }
    </script>
</body>
</html>
